{
  "name": "@conjure/extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "CONJURE_E2E=1 wxt build",
    "build:safari": "wxt build -b safari --mv3",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@conjure/core": "workspace:*",
    "@conjure/fig-clipboard": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "wxt": "^0.21.4"
  }
}
